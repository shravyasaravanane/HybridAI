# Copy to .env.local and fill in values from
# Firebase console > Project settings > General > Your apps > Web app > SDK setup and configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check (required by Firebase AI Logic)
# Production: reCAPTCHA Enterprise site key (Firebase console > Security > App Check > Apps > your web app)
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=
# Local development / judging: set to "true" to print a debug token in the console,
# or paste an already-registered debug token string. Register it under
# Firebase console > Security > App Check > Apps > (overflow menu) > Manage debug tokens.
# Never ship a debug token in a public production build you don't control.
VITE_APPCHECK_DEBUG_TOKEN=true

# Optional: use local Auth + Firestore emulators (npx firebase-tools emulators:start --project demo-tandem)
VITE_USE_EMULATORS=false
