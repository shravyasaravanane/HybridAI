# Copy to .env.local and fill in values from
# Firebase console > Project settings > General > Your apps > Web app > SDK setup and configuration
# (Firebase web API keys identify the project; App Check and security rules protect it.)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# --- App Check (required by Firebase AI Logic) ---
# Production: set ONE of these (Enterprise is what the AI Logic docs recommend).
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=
VITE_RECAPTCHA_V3_SITE_KEY=

# Local development: "true" prints a debug token in the browser console on first run.
# Register it in Firebase console > App Check > Apps > (overflow menu) > Manage debug tokens,
# then paste the token string here so it stays stable. Only used by `npm run dev`.
VITE_APPCHECK_DEBUG_TOKEN=true
# Opt-in: also use the debug token in production builds (judging-only; revoke afterwards).
VITE_APPCHECK_DEBUG_IN_PROD=false

# Optional: use local Auth + Firestore emulators (npx firebase-tools emulators:start --project demo-tandem)
VITE_USE_EMULATORS=false
